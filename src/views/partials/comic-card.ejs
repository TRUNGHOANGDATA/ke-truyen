<a class="cc" href="<%= detailUrl(comic.slug) %>">
  <div class="thumb">
    <% if (String(comic.slug).startsWith("tf~")) { %><span class="kindflag">Chữ</span><% } %>
    <img loading="lazy" src="<%= img(comic.thumbUrl) %>" alt="<%= comic.name %>">
    <% if (comic.when) { %><span class="when"><%= comic.when %></span><% } %>
    <% if (comic.unread) { %><span class="hotflag"><%= comic.unread %></span><% } %>
    <% if (comic.latestChapter) { %><span class="newflag">Chương <b><%= comic.latestChapter %></b></span><% } %>
  </div>
  <div class="tt"><%= comic.name %></div>
  <% if (comic.latestChapter) { %><div class="row"><span class="ch">Chương <%= comic.latestChapter %></span></div><% } %>
</a>
