<div class="topnav"><div class="topnav-in">
  <a class="logo" href="/">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h12a1 1 0 0 1 1 1v19l-7-4.4L5 22V3a1 1 0 0 1 1-1z"/></svg>
    Kệ Truyện
  </a>
  <nav class="mainnav">
    <a href="/" class="<%= active==='home'?'sel':'' %>">Trang chủ</a>
    <a href="/browse" class="<%= active==='browse'?'sel':'' %>">Thể loại</a>
    <a href="/chu" class="<%= active==='chu'?'sel':'' %>">Truyện chữ</a>
    <a href="/following" class="<%= active==="following"?"sel":"" %>">Đang theo dõi</a>
  </nav>
  <form class="navsearch-form" action="/search" method="get" role="search">
    <input class="navsearch" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="⌕ Tìm truyện…" autocomplete="off">
    <div class="navsug" id="navSug" hidden></div>
  </form>
  <div class="who"><span class="nm">Bạn</span><span class="av">N</span></div>
</div></div>
<script type="module">
  // Gợi ý sống khi gõ ở ô tìm trên thanh đầu (truyện tranh + truyện chữ).
  const inp = document.querySelector('.navsearch');
  const box = document.getElementById('navSug');
  if (inp && box) {
    const pack = (u) => u ? '/img?i=' + btoa(unescape(encodeURIComponent(u))).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'') : '';
    const hrefOf = (slug) => slug.startsWith('tf~') ? '/chu/' + slug.slice(3) : '/truyen/' + slug;
    let timer, lastQ = '';
    const hide = () => { box.hidden = true; box.innerHTML = ''; };
    async function run() {
      const q = inp.value.trim();
      if (q.length < 2) return hide();
      if (q === lastQ) return; lastQ = q;
      try {
        const r = await fetch('/api/search?q=' + encodeURIComponent(q), { headers: { 'Content-Type': 'application/json' } });
        if (!r.ok) return hide();
        const { items = [] } = await r.json();
        if (inp.value.trim() !== q) return;               // kết quả cũ, bỏ
        if (!items.length) { box.innerHTML = '<div class="navsug-empty">Không tìm thấy</div>'; box.hidden = false; return; }
        box.innerHTML = items.slice(0, 8).map(c => {
          const novel = String(c.slug).startsWith('tf~');
          return `<a class="navsug-item" href="${hrefOf(c.slug)}">
            <img loading="lazy" src="${pack(c.thumbUrl)}" alt="">
            <span class="navsug-name">${c.name}</span>
            ${novel ? '<span class="navsug-tag">Chữ</span>' : ''}</a>`;
        }).join('');
        box.hidden = false;
      } catch { hide(); }
    }
    inp.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(run, 300); });
    inp.addEventListener('focus', () => { if (box.innerHTML) box.hidden = false; });
    document.addEventListener('click', (e) => { if (!e.target.closest('.navsearch-form')) hide(); });
  }
</script>
