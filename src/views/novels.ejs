<!doctype html>
<html lang="vi"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow"><meta name="theme-color" content="#F1F2F4"><meta name="color-scheme" content="light">
<link rel="manifest" href="/public/manifest.webmanifest"><link rel="stylesheet" href="/public/css/styles.css">
<title><%= title %></title>
</head><body>
<%- include('partials/header', { active, q }) %>

<div class="wrap"><div class="col-main">
  <div class="box">
    <div class="boxhead"><h2>Truyện chữ</h2><div class="sp"></div>
      <span class="cnt"><%= q ? `Kết quả cho "${q}"` : 'Mới cập nhật' %></span></div>

    <form class="navsearch-form" action="/chu" method="get" role="search" style="padding:14px 16px 0">
      <input class="field" name="q" value="<%= q %>" placeholder="⌕ Tìm truyện chữ…" autocomplete="off" style="width:100%">
    </form>

    <% if (err) { %>
      <div class="emptymsg" style="padding:24px 16px">Nguồn truyện chữ tạm thời không phản hồi. Thử lại sau.</div>
    <% } else if (!items.length) { %>
      <div class="emptymsg" style="padding:24px 16px"><%= q ? 'Không tìm thấy truyện nào.' : 'Chưa có truyện.' %></div>
    <% } else { %>
      <div class="cgrid">
        <% items.forEach(comic => { %><%- include('partials/comic-card', { comic }) %><% }) %>
      </div>
    <% } %>
  </div>
</div></div>
</body></html>
