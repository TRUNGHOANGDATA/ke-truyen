<!doctype html>
<html lang="vi"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow"><meta name="theme-color" content="#0B0A0D">
<link rel="stylesheet" href="/public/css/styles.css"><title><%= title %></title>
</head><body class="rd">
<div class="rdbar">
  <a class="bk" href="/truyen/<%= slug %>" aria-label="Quay lại truyện">‹</a>
  <a class="bk" href="/" aria-label="Trang chủ" title="Trang chủ">⌂</a>
  <div class="ti"><div class="a"><%= name %></div><div class="b">Chương <%= chapterName %> · <%= images.length %> trang</div></div>
  <div class="sp"></div>
  <div class="rnav">
    <button class="txt-btn" id="chBtn" type="button" aria-label="Danh sách chương" title="Danh sách chương">☰</button>
    <%
      // Máy chủ đã biết bộ này có ở nguồn nào -> dựng sẵn ngay trong HTML, khỏi
      // chèn muộn bằng JS làm nhảy thanh header. Chưa biết thì reader.js tự tra.
      // Chỉ 1 nguồn có bộ này thì nói thẳng, để người đọc biết là đã tra chứ
      // không phải chức năng hỏng.
      const alts = locals.altList || null;
      const many = (alts && alts.length >= 2) ? alts : null;
      const lone = !!(alts && alts.length === 1);
    %>
    <div class="srcpick" id="srcPick" role="group" aria-label="Chọn nguồn" <%= (many || lone) ? '' : 'hidden' %>><% if (many) { %>
      <span class="sp-lb">Nguồn</span><% many.forEach(s => { %><% if (s.current) { %>
      <span class="sp-i on" title="<%= s.label %> (đang đọc)" aria-current="true"><%= s.n %></span><% } else { %>
      <a class="sp-i" href="<%= s.url %>" title="Đọc từ <%= s.label %>"><%= s.n %></a><% } %><% }) %>
    <% } else if (lone) { %>
      <span class="sp-none" title="Chỉ 1 nguồn có bộ này"><i class="sp-full">Chỉ 1 nguồn có bộ này</i><i class="sp-short">1 nguồn</i></span>
    <% } %></div>
    <button class="txt-btn" id="autoBtn" type="button" aria-label="Tự cuộn" title="Tự cuộn">▶</button>
    <% if (prev) { %><a class="link" href="/doc/<%= slug %>/<%= encodeURIComponent(prev) %>"><button type="button">←<span class="lbl"> Chương trước</span></button></a><% } %>
    <% if (next) { %><a class="link" href="/doc/<%= slug %>/<%= encodeURIComponent(next) %>"><button class="pri" type="button"><span class="lbl">Chương sau </span>→</button></a><% } %>
  </div>
</div>
<%- include('partials/chapter-drawer', { chapterNames, chapterName, base: '/doc/' + slug + '/' }) %>

<% if ((categories && categories.length) || author) { %>
<div class="rdinfo">
  <div class="rdinfo-in">
    <a class="rdinfo-name" href="/truyen/<%= slug %>"><%= name %></a>
    <% if (author) { %><span class="rdinfo-au">· <%= author %></span><% } %>
    <span class="rdinfo-st">· <%= status === 'completed' ? 'Hoàn thành' : 'Đang ra' %></span>
    <div class="rdinfo-tags">
      <% (categories || []).forEach(t => { %><a class="rtag" href="/browse"><%= t %></a><% }) %>
    </div>
  </div>
</div>
<% } %>

<div class="rdstage"><div class="rdcol" id="pages"
     data-slug="<%= slug %>" data-chapter="<%= chapterName %>" data-start="<%= startPage %>" data-next="<%= next || '' %>" data-name="<%= name %>">
  <% images.forEach(img => { %>
    <div class="mpage" data-page="<%= img.page %>">
      <span class="pn"><%= img.page + 1 %> / <%= images.length %></span>
      <img loading="lazy" data-src="<%= imgProxy(img.url) %>" alt="trang <%= img.page + 1 %>">
    </div>
  <% }) %>
  <div class="endblk">
    <div class="lb">Hết chương <%= chapterName %></div>
    <div class="bg">
      <% if (next) { %><a class="link" href="/doc/<%= slug %>/<%= encodeURIComponent(next) %>"><button class="b1" type="button">Chương <%= next %> →</button></a><% } %>
      <a class="link" href="/truyen/<%= slug %>"><button class="b2" type="button">Danh sách chương</button></a>
    </div>
  </div>
</div></div>

<div class="rdfoot"><div class="track"><i id="track"></i></div>
  <div class="row"><div class="p" id="pageLabel">Trang 1 <s>/ <%= images.length %></s></div>
    <div class="p">Chương <%= chapterName %></div></div></div>

<script type="module" src="/public/js/common.js"></script>
<script type="module" src="/public/js/reader.js"></script>
</body></html>
