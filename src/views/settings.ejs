<!doctype html>
<html lang="vi"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow"><link rel="stylesheet" href="/public/css/styles.css"><title><%= title %></title>
</head><body>
<%- include('partials/header', { active }) %>
<div class="wrap"><div class="col-main">

<div class="box">
  <div class="boxhead"><h2>Nguồn truyện</h2></div>
  <div style="padding:14px; display:flex; flex-direction:column; gap:14px; max-width:520px">
    <label style="display:flex; flex-direction:column; gap:6px">
      <span>Nguồn đang dùng</span>
      <select id="source" class="field">
        <option value="truyenqq" <%= source==='truyenqq'?'selected':'' %>>TruyenQQ (crawl, cập nhật từng phút)</option>
        <option value="otruyen" <%= source==='otruyen'?'selected':'' %>>NetTruyen (crawl, kho bổ sung)</option>
      </select>
    </label>

    <label style="display:flex; gap:9px; align-items:flex-start">
      <input id="sup" type="checkbox" <%= supplement ? "checked" : "" %> style="margin-top:3px; flex:0 0 auto">
      <span>Bổ sung truyện từ kho NetTruyen
        <br><small style="color:#888">Các dải thể loại sẽ chèn thêm những bộ TruyenQQ không có; bộ nào TruyenQQ đã có thì bỏ. (Kho bổ sung không có tìm kiếm nên chỉ hiện khi duyệt thể loại.) Chỉ có tác dụng khi nguồn chính là TruyenQQ.</small>
      </span>
    </label>

    <label style="display:flex; flex-direction:column; gap:6px">
      <span>Domain TruyenQQ (khi trang nguồn đổi tên miền)</span>
      <input id="domain" class="field" type="text" value="<%= domain %>" placeholder="https://truyenqq...com">
      <small style="color:#888">Web tự dò domain sống khi cái hiện tại chết. Chỉ cần nhập tay nếu có domain mới toanh chưa có trong danh sách.</small>
    </label>

    <div style="display:flex; gap:10px; flex-wrap:wrap">
      <button class="btn" id="saveSrc" type="button" style="justify-content:center">Lưu nguồn</button>
      <button class="btn" id="saveDom" type="button" style="justify-content:center">Kiểm tra & lưu domain</button>
      <button class="ghost" id="reprobe" type="button" style="justify-content:center">↻ Tự dò lại ngay</button>
    </div>

    <% if (mirrors && mirrors.length) { %>
    <div>
      <small style="color:#888">Domain dự phòng đã cài sẵn:</small>
      <div style="display:flex; flex-wrap:wrap; gap:6px; margin-top:6px">
        <% mirrors.forEach(m => { %>
          <span class="tag <%= m===domain ? 'tag-on' : '' %>"><%= m.replace(/^https?:\/\//,'') %><%= m===domain ? ' ✓' : '' %></span>
        <% }) %>
      </div>
    </div>
    <% } %>

    <% if (comicSources && comicSources.length) { %>
    <div>
      <small style="color:#888">Nguồn truyện tranh đang đăng ký (nút “⇄ Nguồn” ở trang đọc):</small>
      <div style="display:flex; flex-wrap:wrap; gap:6px; margin-top:6px">
        <% comicSources.forEach(s => { %><span class="tag"><%= s.label %></span><% }) %>
      </div>
    </div>
    <% } %>

    <div class="sysbox" id="srcOut"></div>
  </div>
</div>

<div class="box">
  <div class="boxhead"><h2>Dò nguồn từ máy chủ</h2></div>
  <div style="padding:14px; display:flex; flex-direction:column; gap:12px; max-width:760px">
    <small style="color:#888">Máy ở nhà hay bị nhà mạng chặn các trang truyện — dò ở đó ra “chết” trong khi
      máy chủ vào bình thường. Nút này để chính máy chủ thử, nên kết quả mới đúng với cái web thật sự dùng được.
      Mỗi dòng một địa chỉ; để trống thì dò danh sách cài sẵn.</small>
    <textarea id="probeUrls" class="field" rows="4" spellcheck="false"
      placeholder="<%= (probeCandidates || []).slice(0, 3).join('\n') %>"></textarea>
    <div><button class="btn" id="probeBtn" type="button" style="justify-content:center">Dò thử</button></div>
    <div id="probeOut"></div>
  </div>
</div>

<div class="box">
  <div class="boxhead"><h2>Ảnh vỡ? Hỏi máy chủ</h2></div>
  <div style="padding:14px; display:flex; flex-direction:column; gap:12px; max-width:760px">
    <small style="color:#888">Dán link chương đang lỗi vào đây. Máy chủ sẽ lấy ảnh đầu của chương rồi thử
      từng tổ hợp host và referer, báo lại nguyên văn mã trả về — để biết CDN của nguồn chết hẳn hay chỉ
      chặn hotlink. Nhìn từ trình duyệt thì hai thứ giống hệt nhau, nhưng cách chữa khác hẳn.</small>
    <input id="diagLink" class="field" type="text" spellcheck="false" placeholder="/doc/ten-truyen/19">
    <div><button class="btn" id="diagBtn" type="button" style="justify-content:center">Chẩn đoán</button></div>
    <div id="diagOut"></div>
  </div>
</div>

<div class="box">
  <div class="boxhead"><h2>Đổi mật khẩu</h2></div>
  <div style="padding:14px; display:flex; flex-direction:column; gap:10px; max-width:420px">
    <input id="cur" class="field" type="password" placeholder="Mật khẩu hiện tại" autocomplete="current-password">
    <input id="next" class="field" type="password" placeholder="Mật khẩu mới (≥6 ký tự)" autocomplete="new-password">
    <button class="btn" id="save" type="button" style="justify-content:center">Đổi mật khẩu</button>
    <div class="sysbox" id="out"></div>
  </div>
</div></div></div>
<script type="module">
  import { api } from '/public/js/common.js';
  const srcOut = document.getElementById('srcOut');

  document.getElementById('saveSrc').addEventListener('click', async () => {
    srcOut.textContent = 'Đang lưu…';
    try {
      const r = await api('/settings/source', { method: 'POST', body: JSON.stringify({ source: document.getElementById('source').value }) });
      srcOut.textContent = 'Đã đổi nguồn sang ' + r.source + '. Tải lại trang để thấy truyện mới.';
    } catch (e) { srcOut.textContent = 'Lỗi: ' + e.message; }
  });

  document.getElementById('sup').addEventListener('change', async (e) => {
    const on = e.target.checked;
    srcOut.textContent = on ? 'Đang bật bổ sung…' : 'Đang tắt bổ sung…';
    try {
      const r = await api('/settings/supplement', { method: 'POST', body: JSON.stringify({ on }) });
      srcOut.textContent = r.supplement
        ? 'Đã bật bổ sung từ kho NetTruyen. Tải lại trang để thấy.'
        : 'Đã tắt, chỉ còn truyện từ TruyenQQ. Tải lại trang để thấy.';
    } catch (err) {
      e.target.checked = !on;            // trả ô tick về đúng trạng thái thật
      srcOut.textContent = 'Lỗi: ' + err.message;
    }
  });

  document.getElementById('saveDom').addEventListener('click', async () => {
    srcOut.textContent = 'Đang kiểm tra domain…';
    try {
      const r = await api('/settings/domain', { method: 'POST', body: JSON.stringify({ domain: document.getElementById('domain').value }) });
      srcOut.textContent = 'Domain sống, đã lưu: ' + r.domain;
      document.getElementById('domain').value = r.domain;
    } catch (e) { srcOut.textContent = 'Lỗi: ' + e.message; }
  });

  document.getElementById('reprobe').addEventListener('click', async () => {
    srcOut.textContent = 'Đang dò các domain TruyenQQ…';
    try {
      const r = await api('/settings/reprobe', { method: 'POST' });
      srcOut.textContent = 'Đã tìm được domain sống: ' + r.domain;
      document.getElementById('domain').value = r.domain;
    } catch (e) { srcOut.textContent = 'Không dò được domain nào sống: ' + e.message; }
  });

  // Dò nguồn từ máy chủ: hiện bảng kết quả (sống/chết, tốc độ, khung web nhận ra).
  const probeBtn = document.getElementById('probeBtn');
  const probeOut = document.getElementById('probeOut');
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

  probeBtn.addEventListener('click', async () => {
    probeBtn.disabled = true;
    probeOut.innerHTML = '<div class="sysbox">Máy chủ đang dò… (tối đa ~10 giây mỗi trang)</div>';
    try {
      const urls = document.getElementById('probeUrls').value.split(/[\s,]+/).filter(Boolean);
      const { results = [] } = await api('/settings/probe', { method: 'POST', body: JSON.stringify({ urls }) });
      results.sort((a, b) => (b.ok - a.ok) || ((a.ms || 9e9) - (b.ms || 9e9)));
      probeOut.innerHTML = '<table class="probe"><thead><tr><th>Trang</th><th>Kết quả</th><th>Tốc độ</th><th>Khung web</th></tr></thead><tbody>'
        + results.map(r => {
            const host = esc(String(r.input || '').replace(/^https?:\/\//, ''));
            const verdict = r.ok
              ? '<b style="color:#1a7f37">Sống</b>' + (r.comicCount ? ' · ' + r.comicCount + ' link truyện' : '')
              : '<span style="color:#b42318">' + esc(r.error || ('HTTP ' + r.status)) + '</span>';
            const theme = r.adapter
              ? '<b>' + esc(r.themeLabel) + '</b><br><small style="color:#888">dùng lại ' + esc(r.adapter) + '</small>'
              : (r.themeLabel ? esc(r.themeLabel) + '<br><small style="color:#888">phải viết parser mới</small>'
                              : '<small style="color:#888">—</small>');
            return '<tr><td>' + host + (r.finalUrl ? '<br><small style="color:#888">→ ' + esc(r.finalUrl) + '</small>' : '')
              + '</td><td>' + verdict + '</td><td>' + (r.ms ? r.ms + 'ms' : '—') + '</td><td>' + theme + '</td></tr>';
          }).join('')
        + '</tbody></table>';
    } catch (e) { probeOut.innerHTML = '<div class="sysbox">Lỗi: ' + esc(e.message) + '</div>'; }
    finally { probeBtn.disabled = false; }
  });

  // Chẩn đoán ảnh vỡ: bày ra đúng những gì máy chủ nhận được, không diễn giải thêm.
  const diagBtn = document.getElementById('diagBtn');
  const diagOut = document.getElementById('diagOut');
  diagBtn.addEventListener('click', async () => {
    diagBtn.disabled = true;
    diagOut.innerHTML = '<div class="sysbox">Máy chủ đang thử tải ảnh…</div>';
    try {
      const r = await api('/settings/diagnose-image', { method: 'POST',
        body: JSON.stringify({ link: document.getElementById('diagLink').value }) });
      if (r.error) { diagOut.innerHTML = '<div class="sysbox">' + esc(r.error) + '</div>'; return; }
      const rows = (r.attempts || []).map(a =>
        '<tr><td>' + esc(a.host) + '</td><td>' + esc(a.referer) + '</td><td>'
        + (a.ok ? '<b style="color:#1a7f37">OK ' + a.bytes + ' byte</b>'
                : '<span style="color:#b42318">' + esc(a.error || ('HTTP ' + a.status)) + '</span>')
        + '</td><td>' + a.ms + 'ms</td></tr>').join('');
      diagOut.innerHTML =
        '<div class="sysbox">' + esc(r.comic || '') + (r.chapter ? ' · chương ' + esc(r.chapter) : '')
          + (r.imageCount ? ' · ' + r.imageCount + ' ảnh' : '')
          + (r.allowed === false ? '<br><b>Host ảnh này chưa được proxy cho qua.</b>' : '')
          + '<br>' + esc(r.verdict || '') + '</div>'
        + (rows ? '<table class="probe"><thead><tr><th>Host</th><th>Referer đã thử</th><th>Kết quả</th><th>Thời gian</th></tr></thead><tbody>'
            + rows + '</tbody></table>' : '');
    } catch (e) { diagOut.innerHTML = '<div class="sysbox">Lỗi: ' + esc(e.message) + '</div>'; }
    finally { diagBtn.disabled = false; }
  });

  document.getElementById('save').addEventListener('click', async () => {
    const out = document.getElementById('out');
    try {
      const r = await api('/settings/password', { method: 'POST', body: JSON.stringify({
        current: document.getElementById('cur').value, next: document.getElementById('next').value }) });
      out.innerHTML = 'Xong. Dán dòng này vào <code>.env</code> (PASSWORD_HASH) rồi khởi động lại:<br><code>' + r.hash + '</code>';
    } catch (e) { out.textContent = 'Lỗi: ' + e.message; }
  });
</script>
</body></html>
