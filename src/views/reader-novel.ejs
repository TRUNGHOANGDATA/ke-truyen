<!doctype html>
<html lang="vi"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow"><meta name="theme-color" content="#F1F2F4"><meta name="color-scheme" content="light">
<link rel="stylesheet" href="/public/css/styles.css"><title><%= title %></title>
</head><body class="rd">
<div class="rdbar">
  <a class="bk" href="/chu/<%= clean %>" aria-label="Quay lại">‹</a>
  <div class="ti"><div class="a"><%= name %></div><div class="b">Chương <%= chapterName %><%= chapterTitle ? ' · ' + chapterTitle.replace(/^Ch[uươ]+ng\s*[\d.]+\s*:?\s*/i,'') : '' %></div></div>
  <div class="sp"></div>
  <div class="rnav">
    <button class="txt-btn" id="ttsBtn" type="button" aria-label="Nghe truyện" title="Nghe">🔊</button>
    <button class="txt-btn" id="autoBtn" type="button" aria-label="Tự cuộn" title="Tự cuộn">▶</button>
    <button class="txt-btn" id="cfgBtn" type="button" aria-label="Tuỳ chỉnh" title="Tuỳ chỉnh">⚙</button>
    <% if (prev) { %><a class="link" href="/doc-chu/<%= clean %>/<%= encodeURIComponent(prev) %>"><button type="button">←<span class="lbl"> Trước</span></button></a><% } %>
    <% if (next) { %><a class="link" href="/doc-chu/<%= clean %>/<%= encodeURIComponent(next) %>"><button class="pri" type="button"><span class="lbl">Sau </span>→</button></a><% } %>
  </div>
</div>

<div class="nvcfg-back" id="nvcfgBack" hidden></div>
<div class="nvcfg" id="nvcfg" hidden>
  <div class="nvcfg-head">Tuỳ chỉnh đọc <button class="nvcfg-x" id="cfgClose" type="button" aria-label="Đóng">✕</button></div>
  <div class="nvrow"><span>Nền</span><div class="nvbtns" data-group="theme">
    <button type="button" data-th="light">Sáng</button><button type="button" data-th="paper">Giấy</button><button type="button" data-th="dark">Tối</button></div></div>
  <div class="nvrow"><span>Kiểu chữ</span><div class="nvbtns" data-group="ff">
    <button type="button" data-ff="sans">Không chân</button><button type="button" data-ff="serif">Có chân</button></div></div>
  <div class="nvrow"><span>Cỡ chữ</span><div class="nvbtns"><button type="button" id="fMinus">A−</button><span class="nvval" id="fVal"></span><button type="button" id="fPlus">A+</button></div></div>
  <div class="nvrow"><span>Giãn dòng</span><div class="nvbtns"><button type="button" id="lhMinus">−</button><span class="nvval" id="lhVal"></span><button type="button" id="lhPlus">+</button></div></div>
  <div class="nvrow"><span>Tốc độ cuộn</span><div class="nvbtns"><button type="button" id="spMinus">−</button><span class="nvval" id="spVal"></span><button type="button" id="spPlus">+</button></div></div>
  <div class="nvrow"><span>Tốc độ đọc</span><div class="nvbtns"><button type="button" id="ttsMinus">−</button><span class="nvval" id="ttsVal"></span><button type="button" id="ttsPlus">+</button></div></div>
</div>

<div class="rdstage novel">
  <article class="rdcol novel-col" id="novel"
           data-slug="<%= slug %>" data-chapter="<%= chapterName %>" data-start="<%= startPercent %>">
    <h1 class="novel-h"><%= name %></h1>
    <div class="novel-ch">Chương <%= chapterName %><%= chapterTitle ? ': ' + chapterTitle.replace(/^Ch[uươ]+ng\s*[\d.]+\s*:?\s*/i,'') : '' %></div>
    <% paragraphs.forEach(p => { %><p><%= p %></p><% }) %>

    <div class="endblk">
      <div class="lb">Hết chương <%= chapterName %></div>
      <div class="bg">
        <% if (next) { %><a class="link" href="/doc-chu/<%= clean %>/<%= encodeURIComponent(next) %>"><button class="b1" type="button">Chương sau →</button></a><% } %>
        <a class="link" href="/chu/<%= clean %>"><button class="b2" type="button">Danh sách chương</button></a>
      </div>
    </div>
  </article>
</div>

<div class="rdfoot"><div class="track"><i id="track"></i></div>
  <div class="row"><div class="p" id="posLabel">0%</div>
    <div class="p">Chương <%= chapterName %> · <%= index + 1 %>/<%= total %></div></div></div>

<script type="module" src="/public/js/reader-novel.js"></script>
</body></html>
