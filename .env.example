PORT=3000
DB_PATH=./data/app.db
CACHE_DIR=./cache/images
SESSION_SECRET=change-me-to-a-long-random-string
# bcrypt hash of the login password (generate with: node scripts/hash-password.js)
PASSWORD_HASH=
OTRUYEN_BASE=https://otruyenapi.com/v1/api
CDN_IMAGE_BASE=https://img.otruyenapi.com
DOMAIN=change-me.example.com
SOURCE=truyenqq
TRUYENQQ_BASE=https://truyenqqko.com
# Domain TruyenQQ dự phòng (nó hay nhảy tên miền) — web tự dò và ghi nhớ cái nào sống
# TRUYENQQ_MIRRORS=https://truyenqqko.com,https://truyenqqto.com

# Các kho bổ sung dùng chung khung NetTruyen. Mỗi kho là kho RIÊNG (slug khác nhau)
# nên phải có tiền tố slug riêng. Dạng: id|Nhãn|base|tiền_tố~[|apiBase], cách nhau dấu phẩy.
# Bỏ trống = dùng danh sách cài sẵn trong src/config.js.
# NETTRUYEN_SITES=nettruyen|NetTruyen|https://nettruyen.id|ot~|https://nettruyen-api.clubc.org,nettruyenar|NetTruyen 2|https://nettruyenar.com|nar~
# Ứng viên cho nút "Dò nguồn từ máy chủ" ở trang /settings
# PROBE_CANDIDATES=https://nettruyenar.com,https://nettruyenx.net

# Google Drive — lưu ảnh chương để đọc lâu dài (không bắt buộc)
# Lấy bằng: node scripts/drive-auth.js <CLIENT_ID> <CLIENT_SECRET>
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=
DRIVE_FOLDER_ID=root
